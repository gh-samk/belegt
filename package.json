{
  "name": "belegt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev:server": "bun --watch server/index.ts",
    "typecheck": "bun run postinstall && tsc -p .",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "vitest run",
    "dev:app": "vite",
    "build": "vite build",
    "e2e": "playwright test",
    "mac:bauen": "mac/bauen.sh",
    "mac:test": "mac/testen.sh",
    "screenshots": "LANG=de_DE.UTF-8 LANGUAGE=de DOKU_SCREENSHOTS=1 playwright test --project screenshots",
    "postinstall": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy preferredLanguage baseLocale"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.15",
    "@firsttris/gobd-kern": "https://github.com/firsttris/haben/releases/download/gobd-kern-v0.2.0/firsttris-gobd-kern-0.2.0.tgz",
    "@simplewebauthn/browser": "13.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.15",
    "client-zip": "2",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.1",
    "fflate": "0.8",
    "hono": "^4.13.18",
    "imapflow": "2",
    "nodemailer": "^10.5.0",
    "pdf-lib": "^1.17.1",
    "postal-mime": "4.2.0",
    "postgres": "^4.1.1",
    "pst-extractor": "1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smtp-server": "3",
    "unpdf": "^2.2.0",
    "zod": "^4.6.7",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@inlang/paraglide-js": "^3.2.2",
    "@inlang/plugin-message-format": "^4.6.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "jose": "^6.2.17",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
